{
  "$defs": {
    "EventType": {
      "enum": [
        "financial_operation",
        "financing_cap_table",
        "contract_commercial",
        "product_technology",
        "governance_people",
        "legal_compliance",
        "capacity_assets",
        "exit_liquidity",
        "information_quality"
      ],
      "title": "EventType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "research-candidate-analysis-v1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "headline": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Headline",
      "type": "string"
    },
    "what_changed": {
      "maxLength": 600,
      "minLength": 1,
      "title": "What Changed",
      "type": "string"
    },
    "why_it_matters": {
      "maxLength": 800,
      "minLength": 1,
      "title": "Why It Matters",
      "type": "string"
    },
    "potential_impacts": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 3,
      "title": "Potential Impacts",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Uncertainties",
      "type": "array"
    },
    "evidence_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "maxItems": 5,
      "minItems": 1,
      "title": "Evidence Ids",
      "type": "array"
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "follow_up_items": {
      "items": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "title": "Follow Up Items",
      "type": "array"
    },
    "impact_direction": {
      "enum": [
        "positive",
        "negative",
        "mixed",
        "neutral",
        "uncertain"
      ],
      "title": "Impact Direction",
      "type": "string"
    },
    "disclaimer": {
      "const": "模型辅助解读，内容仍待核实，不构成投资建议。",
      "title": "Disclaimer",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "headline",
    "what_changed",
    "why_it_matters",
    "potential_impacts",
    "uncertainties",
    "evidence_ids",
    "confidence",
    "follow_up_items",
    "impact_direction",
    "disclaimer"
  ],
  "title": "ResearchCandidateAnalysisOutput",
  "type": "object"
}
