{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealflowradar.cn/schemas/investor_change_analysis.schema.json",
  "title": "InvestorChangeAnalysisOutput",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "headline",
    "before_value",
    "after_value",
    "what_changed",
    "why_it_matters",
    "potential_impacts",
    "uncertainties",
    "evidence_ids",
    "confidence",
    "follow_up_items",
    "impact_direction",
    "disclaimer"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "investor-change-analysis-v1" },
    "headline": { "type": "string", "minLength": 1, "maxLength": 120 },
    "before_value": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "after_value": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "what_changed": { "type": "string", "minLength": 1, "maxLength": 600 },
    "why_it_matters": { "type": "string", "minLength": 1, "maxLength": 800 },
    "potential_impacts": {
      "type": "array",
      "maxItems": 3,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "format": "uuid" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "follow_up_items": {
      "type": "array",
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "impact_direction": {
      "type": "string",
      "enum": ["positive", "negative", "mixed", "neutral", "uncertain"]
    },
    "disclaimer": { "type": "string", "const": "模型辅助解读，不构成投资建议。" }
  }
}
