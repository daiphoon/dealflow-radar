# M5B 香港单机邀请测试环境示例。复制为 deploy/single-host.env 后再替换占位值。
SITE_ADDRESS=app.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
ALLOW_INSECURE_LOCALHOST=false

APP_MODE=production
AUTH_PROVIDER=cloudbase
CLOUDBASE_ENV_ID=replace_with_cloudbase_env_id
CLOUDBASE_CLIENT_ID=
CLOUDBASE_AUTH_TIMEOUT_SECONDS=5
CLOUDBASE_AUTH_MAX_RESPONSE_BYTES=64000
CLOUDBASE_AUTH_USER_AGENT=DealflowRadarAuth/1.0

DEPLOYMENT_PROFILE=single_host
POSTGRES_DATABASE=equity_radar
POSTGRES_OWNER_USER=migration_user
POSTGRES_OWNER_PASSWORD=replace_with_owner_password
POSTGRES_RESTORE_DATABASE=equity_radar_restore_test
POSTGRES_RESTORE_USER=restore_owner
POSTGRES_RESTORE_PASSWORD=replace_with_restore_password
DATABASE_ADMIN_URL=postgresql+psycopg://migration_user:replace_with_owner_password@database:5432/equity_radar
DATABASE_URL=postgresql+psycopg://equity_app:replace_with_app_password@database:5432/equity_radar
BACKUP_DATABASE_URL=postgresql://migration_user:replace_with_owner_password@database:5432/equity_radar
RESTORE_TEST_DATABASE_URL=postgresql://restore_owner:replace_with_restore_password@restore-db:5432/equity_radar_restore_test
APP_DATABASE_USER=equity_app
APP_DATABASE_PASSWORD=replace_with_app_password

BACKUP_DIRECTORY=./backups/production
BACKUP_REQUIRE_ENCRYPTION=true
BACKUP_AGE_RECIPIENT=age1replace_with_public_recipient
BACKUP_AGE_IDENTITY_PATH=./deploy/backup-age-identity.key
COSCLI_CONFIG_PATH=./deploy/coscli.secret
COS_BUCKET_ALIAS=replace_with_private_bucket_alias
COS_BACKUP_PREFIX=dealflow-radar/postgres

EXTERNAL_CALLS_ENABLED=false
PAID_API_CALLS_ENABLED=false
AUTO_REFRESH_ENABLED=false
AUTO_PUBLISH_ENABLED=false
TRUSTED_SOURCE_CALLS_ENABLED=false
SOURCE_MONITOR_SCHEDULER_ENABLED=false
TIANYANCHA_IDENTITY_CALLS_ENABLED=false
REVIEW_WORKBENCH_ENABLED=false

PERSONAL_MONTHLY_SEARCH_LIMIT=100
PERSONAL_WATCHLIST_COMPANY_LIMIT=20
PERSONAL_MONTHLY_REPORT_LIMIT=10
PERSONAL_MONTHLY_REQUEST_LIMIT=5
PERSONAL_REQUEST_COOLDOWN_HOURS=24

BACKEND_IMAGE=dealflow-radar-backend:replace_with_commit_sha
FRONTEND_IMAGE=dealflow-radar-frontend:replace_with_commit_sha
