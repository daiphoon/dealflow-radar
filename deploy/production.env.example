# 复制为 deploy/production.env 后填写真实值；该文件会被 Git 忽略。
SITE_ADDRESS=app.example.com
APP_PUBLIC_ORIGIN=https://app.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
ALLOW_INSECURE_LOCALHOST=false

APP_MODE=production
AUTH_PROVIDER=cloudbase
CLOUDBASE_ENV_ID=replace_with_cloudbase_env_id
CLOUDBASE_CLIENT_ID=
CLOUDBASE_AUTH_TIMEOUT_SECONDS=5
CLOUDBASE_AUTH_MAX_RESPONSE_BYTES=64000
CLOUDBASE_AUTH_USER_AGENT=DealflowRadarAuth/1.0
PHONE_LOGIN_ENABLED=false
AUTH_PHONE_CODE_COOLDOWN_SECONDS=60
AUTH_PHONE_DAILY_LIMIT=5
AUTH_PHONE_ENV_DAILY_LIMIT=50

DATABASE_ADMIN_URL=postgresql+psycopg://migration_user:replace_admin_password@database.internal:5432/equity_radar
DATABASE_URL=postgresql+psycopg://equity_app:replace_app_password@database.internal:5432/equity_radar
BACKUP_DATABASE_URL=postgresql://migration_user:replace_admin_password@database.internal:5432/equity_radar
RESTORE_TEST_DATABASE_URL=postgresql://restore_owner:replace_restore_password@restore-database.internal:5432/equity_radar_restore_test
APP_DATABASE_USER=equity_app
APP_DATABASE_PASSWORD=replace_app_password
BACKUP_DIRECTORY=./backups/deployment

EXTERNAL_CALLS_ENABLED=false
PAID_API_CALLS_ENABLED=false
AUTO_REFRESH_ENABLED=false
AUTO_PUBLISH_ENABLED=false
TRUSTED_SOURCE_CALLS_ENABLED=false
SOURCE_MONITOR_SCHEDULER_ENABLED=false
TIANYANCHA_IDENTITY_CALLS_ENABLED=false
TIANYANCHA_RESEARCH_CALLS_ENABLED=false
ON_DEMAND_RESEARCH_ENABLED=false
REVIEW_WORKBENCH_ENABLED=false

PERSONAL_MONTHLY_SEARCH_LIMIT=100
PERSONAL_WATCHLIST_COMPANY_LIMIT=20
PERSONAL_MONTHLY_REPORT_LIMIT=10
PERSONAL_DAILY_REQUEST_LIMIT=10
PERSONAL_MONTHLY_REQUEST_LIMIT=30
PERSONAL_REQUEST_COOLDOWN_HOURS=24
ON_DEMAND_RESEARCH_POLICY_VERSION=on-demand-research-v1
ON_DEMAND_IDENTITY_CONFIRMATION_TTL_HOURS=24
ON_DEMAND_WORKER_LEASE_SECONDS=300
ON_DEMAND_PROVIDER_DAILY_CALL_LIMIT=1000
ON_DEMAND_PROVIDER_MONTHLY_CALL_LIMIT=10000
ON_DEMAND_PROVIDER_RESERVE_PERCENT=10
ON_DEMAND_MAX_PROVIDER_CALLS_PER_COMPANY=8

BACKEND_IMAGE=dealflow-radar-backend:replace_with_commit_sha
FRONTEND_IMAGE=dealflow-radar-frontend:replace_with_commit_sha
