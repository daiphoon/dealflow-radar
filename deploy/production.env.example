# 复制为 deploy/production.env 后填写真实值；该文件会被 Git 忽略。
SITE_ADDRESS=app.example.com
APP_PUBLIC_ORIGIN=https://app.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
ALLOW_INSECURE_LOCALHOST=false

APP_MODE=production
AUTH_PROVIDER=cloudbase
CLOUDBASE_ENV_ID=replace_with_cloudbase_env_id
CLOUDBASE_CLIENT_ID=
CLOUDBASE_AUTH_TIMEOUT_SECONDS=5
CLOUDBASE_AUTH_MAX_RESPONSE_BYTES=64000
CLOUDBASE_AUTH_USER_AGENT=DealflowRadarAuth/1.0
PHONE_LOGIN_ENABLED=false
AUTH_PHONE_CODE_COOLDOWN_SECONDS=60
AUTH_PHONE_DAILY_LIMIT=5
AUTH_PHONE_ENV_DAILY_LIMIT=50

DATABASE_ADMIN_URL=postgresql+psycopg://migration_user:replace_admin_password@database.internal:5432/equity_radar
DATABASE_URL=postgresql+psycopg://equity_app:replace_app_password@database.internal:5432/equity_radar
BACKUP_DATABASE_URL=postgresql://migration_user:replace_admin_password@database.internal:5432/equity_radar
RESTORE_TEST_DATABASE_URL=postgresql://restore_owner:replace_restore_password@restore-database.internal:5432/equity_radar_restore_test
APP_DATABASE_USER=equity_app
APP_DATABASE_PASSWORD=replace_app_password
BACKUP_DIRECTORY=./backups/deployment

EXTERNAL_CALLS_ENABLED=false
PAID_API_CALLS_ENABLED=false
AUTO_REFRESH_ENABLED=false
AUTO_PUBLISH_ENABLED=false
TRUSTED_SOURCE_CALLS_ENABLED=false
SOURCE_MONITOR_SCHEDULER_ENABLED=false
WEB_RESEARCH_ENABLED=false
WEB_RESEARCH_CALLS_ENABLED=false
INVESTOR_ANALYSIS_ENABLED=false
REVIEW_WORKBENCH_ENABLED=false
TENDER_EVENTS_ENABLED=false

PERSONAL_MONTHLY_SEARCH_LIMIT=100
PERSONAL_WATCHLIST_COMPANY_LIMIT=20
PERSONAL_MONTHLY_REPORT_LIMIT=10
PERSONAL_DAILY_REQUEST_LIMIT=10
PERSONAL_MONTHLY_REQUEST_LIMIT=30
PERSONAL_REQUEST_COOLDOWN_HOURS=24
INVESTOR_ANALYSIS_POLICY_VERSION=investor-analysis-v1
INVESTOR_ANALYSIS_PROVIDER=deepseek
INVESTOR_ANALYSIS_MODEL=deepseek-v4-flash
INVESTOR_ANALYSIS_MIN_MATERIALITY=60
INVESTOR_ANALYSIS_MAX_INPUT_CHARACTERS=12000
INVESTOR_ANALYSIS_MAX_OUTPUT_TOKENS=1200
INVESTOR_ANALYSIS_MONTHLY_TOKEN_LIMIT=500000
INVESTOR_ANALYSIS_TIMEOUT_SECONDS=30
INVESTOR_ANALYSIS_MAX_RESPONSE_BYTES=128000
INVESTOR_ANALYSIS_RETRY_LIMIT=1
INVESTOR_ANALYSIS_WORKER_LEASE_SECONDS=300
INVESTOR_ANALYSIS_INPUT_COST_PER_MILLION_TOKENS=0
INVESTOR_ANALYSIS_OUTPUT_COST_PER_MILLION_TOKENS=0
INVESTOR_ANALYSIS_EXTERNAL_CALLS_ENABLED=false
INVESTOR_ANALYSIS_PAID_API_CALLS_ENABLED=false
ANALYSIS_WORKER_USER_ID=
WORKER_TENANT_ID=
DEEPSEEK_API_KEY=
# E0—E3 首次部署保持关闭；金额为 CNY，空报价表示未知。
WATCHLIST_MONITOR_ENABLED=false
WATCHLIST_MONITOR_POLICY_VERSION=watchlist-v1
WATCHLIST_MONITOR_INTERVAL_DAYS=7
WATCHLIST_MONITOR_MAX_COMPANIES_PER_RUN=5
WATCHLIST_MONITOR_COOLDOWN_HOURS=24
WATCHLIST_MONITOR_FAILURE_BACKOFF_MAX_DAYS=30
WATCHLIST_MONITOR_NO_CHANGE_BACKOFF_AFTER=3
WATCHLIST_MONITOR_MAX_INTERVAL_DAYS=30
WEB_RESEARCH_COST_VERSION=web-cost-v1
WEB_RESEARCH_BAIDU_PRICE_PER_CALL=
WEB_RESEARCH_BOCHA_PRICE_PER_CALL=
WEB_RESEARCH_UNKNOWN_PRICE_UPPER_BOUND=
WEB_RESEARCH_TASK_LIMIT=0
WEB_RESEARCH_COMPANY_DAILY_LIMIT=0
WEB_RESEARCH_COMPANY_WEEKLY_LIMIT=0
WEB_RESEARCH_SYSTEM_WEEKLY_LIMIT=0
WEB_RESEARCH_SYSTEM_MONTHLY_LIMIT=0
WEB_RESEARCH_POLICY_VERSION=bounded-web-v3
WEB_RESEARCH_PRIMARY_PROVIDER=baidu
WEB_RESEARCH_FALLBACK_PROVIDER=bocha
WEB_RESEARCH_SEARCH_CACHE_TTL_DAYS=14
WEB_RESEARCH_DOCUMENT_CACHE_TTL_DAYS=14
WEB_RESEARCH_MAX_SEARCH_CALLS_PER_JOB=4
WEB_RESEARCH_MAX_RESULTS_PER_SEARCH=10
WEB_RESEARCH_MAX_CANDIDATE_URLS=12
WEB_RESEARCH_MAX_DOCUMENTS_PER_JOB=3
WEB_RESEARCH_MAX_FETCH_REQUESTS_PER_JOB=8
WEB_RESEARCH_MAX_DOWNLOAD_BYTES_PER_JOB=2000000
WEB_RESEARCH_MAX_RESPONSE_BYTES=500000
WEB_RESEARCH_MAX_PDF_PAGES=40
WEB_RESEARCH_MAX_PDF_TEXT_CHARS=100000
WEB_RESEARCH_PDF_PARSE_TIMEOUT_SECONDS=5
WEB_RESEARCH_MAX_ELAPSED_SECONDS=180
WEB_RESEARCH_DAILY_SEARCH_CALL_LIMIT=50
WEB_RESEARCH_MONTHLY_SEARCH_CALL_LIMIT=1500
WEB_RESEARCH_TIMEOUT_SECONDS=15
WEB_RESEARCH_WORKER_LEASE_SECONDS=300
WEB_RESEARCH_FALLBACK_MIN_SUBJECT_RESULTS=1
WEB_RESEARCH_RECENT_CHANGE_WINDOW_DAYS=365
WEB_RESEARCH_WORKER_POLL_SECONDS=5
WEB_RESEARCH_WORKER_ENABLED=false
WEB_RESEARCH_EXTERNAL_CALLS_ENABLED=false
WEB_RESEARCH_WORKER_CALLS_ENABLED=false
WEB_RESEARCH_PAID_API_CALLS_ENABLED=false
WEB_RESEARCH_WORKER_USER_ID=
BAIDU_SEARCH_API_KEY=
BOCHA_SEARCH_API_KEY=

BACKEND_IMAGE=dealflow-radar-backend:replace_with_commit_sha
FRONTEND_IMAGE=dealflow-radar-frontend:replace_with_commit_sha
